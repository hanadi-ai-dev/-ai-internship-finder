# Demo and live databases are always separate. Set false for verified-source monitoring.
DEMO_MODE=true
DATA_DIR=data
SOURCE_CONFIG=config/sources.json
# Free discovery is default. Brave additionally requires explicit opt-in below.
DISCOVERY_CONFIG=config/discovery.json
ENABLE_BRAVE_SEARCH=false
BRAVE_SEARCH_API_KEY=
# Maximum company outreach alerts per notification run (0 disables).
COMPANY_ALERTS_PER_RUN=10
# Required for all API actions except /health. Choose a strong random value.
API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_SHEET_ID=
# Local credential file path, never commit. Share sheet with service account email.
GOOGLE_APPLICATION_CREDENTIALS=
# Free local bilingual relevance is default, even if an old remote key is present.
# Optional remote classifier requires AI_PROVIDER=openai; not part of zero-cost mode.
AI_PROVIDER=local
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Future application sending: disabled unless explicitly enabled.
EMAIL_SENDING_ENABLED=false
EMAIL_AUTO_APPROVED=false
EMAIL_DAILY_LIMIT=5
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CV_PATH=
TRAINING_LETTER_PATH=
